sequenceDiagram
    autonumber
    actor Client as APIClient
    participant C as OrderLogController
    participant OLS as OrderLogService
    participant PR as PortfolioRepository
    participant IR as InstrumentRepository
    participant OR as OrderLogRepository
    participant QS as QuoteService
    participant VL as ValidationListener
    participant VS as ValidationService
    participant EL as ExecutionListener
    participant ES as ExecutionService
    participant F as FifoAccountingService
    participant K as Kafka

    rect rgb(239, 246, 255)
    Note over Client,K: 1) Intake + publish ORDER_SUBMITTED
    Client->>C: createOrderLog(...)
    C->>OLS: createOrderLog(...)
    OLS->>PR: findOwnedByPortfolioId(...)
    PR-->>OLS: Portfolio
    OLS->>IR: findById(...)
    IR-->>OLS: Instrument
    alt side is BUY or SELL
        loop up to 3 attempts
            OLS->>QS: getExecutionPrice(instrumentId, side)
            QS-->>OLS: quotedPrice or null/error
        end
        alt valid quotedPrice resolved
            OLS->>OLS: setQuotedPrice(quotedPrice)
            OLS->>OR: save SUBMITTED row
            OR-->>OLS: saved log
            OLS->>K: send ORDER_SUBMITTED
            OLS-->>C: OrderLog
            C-->>Client: OrderLogResponse
        else null/non-positive/error after retries
            OLS-->>C: throw InvalidTradeException
            C-->>Client: 4xx error response
        end
    else side is DEPOSIT or WITHDRAW
        OLS->>OR: save SUBMITTED row
        OR-->>OLS: saved log
        OLS->>K: send ORDER_SUBMITTED
        OLS-->>C: OrderLog
        C-->>Client: OrderLogResponse
    end
    end

    rect rgb(255, 241, 242)
    Note over VL,VS: 2) Validation path
    K-->>VL: consume ORDER_SUBMITTED
    VL->>VS: handleOrderSubmitted(...)
    VS->>OLS: appendPendingFromSystem(...)
    OLS->>OR: save/read latest row
    OLS-->>VS: latest row
    alt latest status CANCELLED
        VS-->>VL: stop validation (no append, no Kafka publish)
    else latest status PENDING
            Note over VS: Side checks are BUY cash sufficiency, SELL holdings and lots, WITHDRAW holdings, and DEPOSIT pass.
        alt validation passed
            VS->>OLS: appendAcceptedFromSystem(...)
            OLS->>OR: save ACCEPTED row (unless CANCELLED won race)
            OLS-->>VS: latest row after append attempt
            alt append result is ACCEPTED
                VS->>K: send ORDER_ACCEPTED
            else append skipped due CANCELLED
                VS-->>VL: do not publish ORDER_ACCEPTED
            end
        else validation failed
            VS->>OLS: appendRejectedFromSystem(...)
            OLS->>OR: save REJECTED row (unless CANCELLED won race)
            OLS-->>VS: latest row after append attempt
            alt append result is REJECTED
                VS->>K: send ORDER_REJECTED
            else append skipped due CANCELLED
                VS-->>VL: do not publish ORDER_REJECTED
            end
        end
    else runtime error in validation flow
        VS->>OLS: appendRejectedFromSystem(...)
        OLS->>OR: save REJECTED row (unless CANCELLED won race)
        OLS-->>VS: latest row after append attempt
        alt append result is REJECTED
            VS->>K: send ORDER_REJECTED
        else append skipped due CANCELLED
            VS-->>VL: do not publish ORDER_REJECTED
        end
    end
    end

    rect rgb(236, 253, 245)
    Note over EL,ES: 3) Execution path
    K-->>EL: consume ORDER_ACCEPTED
    EL->>ES: handleOrderAccepted(...)
    ES->>OLS: getLatestOrderLogByOrderIdForUpdate(...)
    OLS->>OR: lock/read latest row
    OR-->>OLS: latest row
    OLS-->>ES: latest row
    Note over ES: Runtime errors in this flow are handled by appending FAILED
    ES->>F: applyExecution(latestAccepted)
    F->>QS: getExecutionPrice(..., side)
    QS-->>F: executionPrice
    F->>F: applyBuy/applySell/applyDeposit/applyWithdraw
    alt outcome.succeeded
        F-->>ES: ExecutionOutcome(success, executionPriceUsed)
        ES->>OLS: appendExecutedFromSystem(...)
        OLS->>OR: save EXECUTED row
    else execution failed
        F-->>ES: ExecutionOutcome(failureReason, executionPriceUsed)
        ES->>OLS: appendFailedFromSystem(...)
        OLS->>OR: save FAILED row
    end
    end

    rect rgb(246, 255, 246)
    Note over Client,OR: 4) Cancellation path (append-only)
    Client->>C: cancelOrder(orderId)
    C->>OLS: cancelOrder(orderId)
    OLS->>OR: findOwnedByOrderIdNewestFirstForUpdate(...)
    OR-->>OLS: latest order log
    alt latest status SUBMITTED or PENDING
        OLS->>OR: save CANCELLED row
        OR-->>OLS: saved CANCELLED row
    else latest status CANCELLED
        OLS-->>C: return existing CANCELLED row
    else latest status is other terminal state
        OLS-->>C: throw OrderCancellationConflictException
    end
    C-->>Client: OrderLogResponse
    Note over Client,OLS: No cancel Kafka event is published in current implementation
    end