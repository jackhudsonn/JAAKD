# Copy to .env and fill in with the privileged (non-anon) Postgres role — never the anon/publishable key.
# Use the Supabase "Session pooler" connection string (port 5432) so Hibernate can hold long-lived connections.
SUPABASE_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres
SUPABASE_DB_USER=<privileged-db-role>
SUPABASE_DB_PASSWORD=<privileged-db-role-password>

# Base project URL, used to fetch the JWKS for validating Supabase-issued JWTs
SUPABASE_URL=https://<project-ref>.supabase.co
