SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/jaakd
SPRING_DATASOURCE_USERNAME=jaakd_app
SPRING_DATASOURCE_PASSWORD=change-me-app-role-password
# Identity provider adapter: only "development" is implemented.
IDENTITY_PROVIDER=development
# Send the session cookie only over HTTPS. Keep false for local http.
AUTH_COOKIE_SECURE=false
