# This file itself is not needed for the application runtime
# It serves as an example for environment variables in prod Beanstalk on AWS

# Lightsail DB
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:<DB_PORT>/<DB_NAME>
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# Kafka VM
SPRING_KAFKA_BOOTSTRAP_SERVERS=<KAFKA_BOOTSTRAP_SERVERS>:<KAFKA_PORT>

# Security
APP_CORS_ALLOWED_ORIGINS=<APP_CORS_ALLOWED_ORIGINS>
AUTH_COOKIE_SECURE=<AUTH_COOKIE_SECURE>

# Identity provider adapter: "development" or "cognito".
IDENTITY_PROVIDER=cognito

# Cognito adapter.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_API_CALL_TIMEOUT=PT10S
COGNITO_API_CALL_ATTEMPT_TIMEOUT=PT5S
COGNITO_RETRY_ATTEMPTS=2

# Spring Profile
SPRING_PROFILES_ACTIVE=production

# Fauxnance
FAUXNANCE_BASE_URL=<FAUXNANCE_BASE_URL>
FAUXNANCE_API_KEY=<FAUXNANCE_API_KEY>

# Analytics DB
ANALYTICS_DB_ENABLED=<ANALYTICS_DB_ENABLED>
ANALYTICS_DB_URL=jdbc:postgresql://<ANALYTICS_DB_HOST>:<ANALYTICS_DB_PORT>/<ANALYTICS_DB_NAME>
ANALYTICS_DB_USERNAME=<ANALYTICS_DB_USERNAME>
ANALYTICS_DB_PASSWORD=<ANALYTICS_DB_PASSWORD>