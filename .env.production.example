# Lightsail DB
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:<DB_PORT>/jaakd-<DB_NAME>
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# Kafka VM
SPRING_KAFKA_BOOTSTRAP_SERVERS=<KAFKA_BOOTSTRAP_SERVERS>

# Security
APP_CORS_ALLOWED_ORIGINS=<APP_CORS_ALLOWED_ORIGINS> #Frontend URL?
IDENTITY_PROVIDER=<IDENTITY_PROVIDER>
AUTH_COOKIE_SECURE=<AUTH_COOKIE_SECURE>

# Fauxnance
FAUXNANCE_BASE_URL=<FAUXNANCE_BASE_URL>
FAUXNANCE_API_KEY=<FAUXNANCE_API_KEY>
