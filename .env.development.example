# Generate strong secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-postgres-password
JAAKD_APP_DB_PASSWORD=change-me-app-role-password

# Spring profile controls environment-specific application configuration.
SPRING_PROFILES_ACTIVE=development

# Identity provider adapter: "development" or "cognito".
IDENTITY_PROVIDER=development

# Cognito adapter.
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_API_CALL_TIMEOUT=PT10S
COGNITO_API_CALL_ATTEMPT_TIMEOUT=PT5S
COGNITO_RETRY_ATTEMPTS=2

# Send the session cookie only over HTTPS.
AUTH_COOKIE_SECURE=false

# Fauxnance service configuration
FAUXNANCE_BASE_URL=change-me-base-url
FAUXNANCE_API_KEY=change-me-api-key

# Analyst view: read-only connection to the analytics database built by analytics/. Leave false until it exists.
ANALYTICS_DB_ENABLED=false
ANALYTICS_DB_PASSWORD=change-me-analytics-app-reader-password
# Analytics copy job: read-only role on jaakd-postgres, and the role that owns the analytics database.
JAAKD_ANALYTICS_DB_PASSWORD=change-me-analytics-source-reader-password
ANALYTICS_PIPELINE_DB_PASSWORD=change-me-analytics-pipeline-password
# Uncomment to start jaakd-analytics-postgres with plain `docker compose up` (needs the passwords above).
# COMPOSE_PROFILES=analytics

# Nightly price history refresh (UTC cron). Set PRICES_HISTORY_ENABLED=false to stop the schedule.
PRICES_HISTORY_ENABLED=true
